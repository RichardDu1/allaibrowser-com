---
// Card.astro — Reusable product/tool card with score, verdict, and use cases
const { 
  title, 
  description, 
  href, 
  score,
  verdictLabel,
  pricing,
  useCases,
  githubStars,
  featured,
  category
} = Astro.props;

const starColor = score >= 9 ? 'text-emerald-400' : score >= 7 ? 'text-primary-400' : score >= 5 ? 'text-yellow-400' : 'text-red-400';
const verdictBadgeClass = verdictLabel === 'buy' ? 'verdict-buy' : verdictLabel === 'wait' ? 'verdict-wait' : 'verdict-skip';
const priceClass = pricing === 'free' ? 'price-free' : pricing === 'freemium' ? 'price-freemium' : pricing === 'paid' ? 'price-paid' : 'price-enterprise';
---

<a href={href} class={`group relative block rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-0.5 ${featured ? 'md:col-span-2 md:row-span-2' : ''}`}>
  <div class="absolute inset-0 bg-gradient-to-br from-primary-500/5 to-accent-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  
  <div class="relative h-full glass-card rounded-xl p-6 flex flex-col gap-4 transition-all duration-300 group-hover:border-primary-500/30 group-hover:shadow-lg group-hover:shadow-primary-500/5">
    <!-- Top row: title + score -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          {category && (
            <span class="text-[10px] font-medium uppercase tracking-wider text-muted bg-white/5 px-2 py-0.5 rounded-full border border-border">
              {category}
            </span>
          )}
          {pricing && (
            <span class={`text-[10px] font-medium uppercase tracking-wider ${priceClass}`}>
              {pricing}
            </span>
          )}
        </div>
        <h3 class="font-bold text-white tracking-tight group-hover:text-primary-400 transition-colors text-lg leading-tight">{title}</h3>
      </div>
      {score && (
        <div class="flex flex-col items-center shrink-0">
          <span class={`text-2xl font-bold ${starColor}`}>{score}</span>
          <span class="text-[10px] text-muted uppercase tracking-wider">/10</span>
        </div>
      )}
    </div>

    <!-- Description -->
    {description && (
      <p class="text-sm text-muted leading-relaxed line-clamp-2">{description}</p>
    )}

    <!-- Use Cases Tags -->
    {useCases && useCases.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {useCases.map((uc) => (
          <span class="text-[11px] font-medium bg-white/5 text-muted px-2 py-0.5 rounded-md border border-border">
            {uc}
          </span>
        ))}
      </div>
    )}

    <!-- Bottom row: verdict + github stars -->
    <div class="flex items-center justify-between pt-2 mt-auto border-t border-border/50">
      {verdictLabel && (
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${verdictBadgeClass}`}>
          {verdictLabel === 'buy' ? '✓ Buy' : verdictLabel === 'wait' ? '○ Wait' : '✕ Skip'}
        </span>
      )}
      {githubStars && (
        <span class="flex items-center gap-1 text-xs text-muted">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          {githubStars >= 1000 ? `${(githubStars / 1000).toFixed(1)}k` : githubStars}
        </span>
      )}
    </div>
  </div>
</a>