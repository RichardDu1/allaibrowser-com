---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allBestOfs = await getCollection('best-ofs');
const sortedBestOfs = allBestOfs.sort((a, b) => a.data.title.localeCompare(b.data.title));

const categoryLabels = {
  'web-agents': 'Web Agents',
  'browser-automation': 'Browser Automation',
  'ai-scraping': 'AI Scraping',
  'testing-tools': 'Testing Tools',
  'browser-extensions': 'Browser Extensions',
};

const pageTitle = 'Best Of — Top AI Browser Tools by Category';
const pageDescription = 'Curated lists of the best AI browser tools, web agents, and automation frameworks in every category.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/best-ofs/"
>
  <main class="container mx-auto px-6 max-w-5xl pt-24 pb-24">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">Best Of</h1>
      <p class="text-lg text-muted max-w-2xl">Curated lists of the best AI browser tools, organized by category. Our top picks based on real-world testing.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedBestOfs.length > 0 ? sortedBestOfs.map((list) => {
        const slug = list.id.split('/').pop();
        return (
          <a href={`/en/best-ofs/${slug}/`} class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-medium text-primary-400 bg-primary-500/10 px-2 py-0.5 rounded-full border border-primary-500/20">
                {categoryLabels[list.data.category] || list.data.category}
              </span>
            </div>
            <h2 class="text-lg font-bold text-white group-hover:text-primary-400 transition-colors mb-2">{list.data.title}</h2>
            <p class="text-sm text-muted mb-4">{list.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {list.data.items.slice(0, 3).map(item => (
                <span class="text-xs text-muted bg-white/5 px-2 py-1 rounded-md border border-border">
                  {item.name}
                </span>
              ))}
              {list.data.items.length > 3 && (
                <span class="text-xs text-muted">+{list.data.items.length - 3} more</span>
              )}
            </div>
          </a>
        );
      }) : (
        <div class="col-span-full text-center py-20">
          <div class="text-4xl mb-4">🏆</div>
          <h3 class="text-xl font-semibold text-white mb-2">No Lists Yet</h3>
          <p class="text-muted">Best-of lists are coming soon.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>