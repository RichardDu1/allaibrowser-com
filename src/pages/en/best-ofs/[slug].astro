---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const bestOfs = await getCollection('best-ofs');
  return bestOfs.map(b => ({
    params: { slug: b.id.split('/').pop() },
    props: { list: b },
  }));
}

const { list } = Astro.props;
const slug = list.id.split('/').pop();

const categoryLabels = {
  'web-agents': 'Web Agents',
  'browser-automation': 'Browser Automation',
  'ai-scraping': 'AI Scraping',
  'testing-tools': 'Testing Tools',
  'browser-extensions': 'Browser Extensions',
};

const pageTitle = `${list.data.title} — AI Browser Tools`;
const pageDescription = list.data.description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://allaibrowser.com/en/best-ofs/${slug}/`}
>
  <main class="container mx-auto px-6 max-w-5xl pt-24 pb-24">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center text-sm text-muted gap-2">
      <a href="/en/best-ofs/" class="hover:text-primary-400 transition-colors">Best Of</a>
      <span>/</span>
      <span class="text-white">{list.data.title}</span>
    </nav>

    <header class="mb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-medium text-primary-400 bg-primary-500/10 px-2 py-0.5 rounded-full border border-primary-500/20">
          {categoryLabels[list.data.category] || list.data.category}
        </span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">{list.data.title}</h1>
      <p class="text-lg text-muted max-w-3xl">{list.data.description}</p>
    </header>

    <!-- Ranked List -->
    <div class="space-y-4">
      {list.data.items.map((item, idx) => {
        const scoreColor = item.score >= 9 ? 'text-emerald-400' : item.score >= 7 ? 'text-primary-400' : 'text-yellow-400';
        const rankBadge = idx === 0 ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : 
                          idx === 1 ? 'bg-primary-500/20 text-primary-400 border-primary-500/30' : 
                          idx === 2 ? 'bg-amber-500/20 text-amber-400 border-amber-500/30' : 
                          'bg-white/5 text-muted border-border';
        const platformHref = item.platform === 'browser-use' ? '/en/reviews/browser-use/' :
                            item.platform === 'stagehand' ? '/en/reviews/stagehand/' :
                            item.platform === 'playwright' ? '/en/tools/playwright/' :
                            item.platform === 'puppeteer' ? '/en/tools/puppeteer/' :
                            item.platform === 'agentql' ? '/en/tools/agentql/' :
                            item.platform === 'browserbase' ? '/en/tools/browserbase/' :
                            item.platform === 'selenium' ? '/en/tools/selenium/' :
                            item.platform === 'cypress' ? '/en/tools/cypress/' : null;
        return (
          <div class={`glass-card rounded-xl p-6 ${idx === 0 ? 'border-primary-500/30' : ''} transition-all duration-300`}>
            <div class="flex items-start gap-4">
              <div class={`w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm border shrink-0 ${rankBadge}`}>
                #{idx + 1}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-4 mb-1">
                  <h3 class="text-lg font-bold text-white">
                    {platformHref ? (
                      <a href={platformHref} class="hover:text-primary-400 transition-colors">{item.name}</a>
                    ) : item.name}
                  </h3>
                  <span class={`text-xl font-bold ${scoreColor} shrink-0`}>{item.score}</span>
                </div>
                <p class="text-sm text-muted">{item.reason}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</BaseLayout>