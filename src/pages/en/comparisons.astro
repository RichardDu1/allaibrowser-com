---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allComparisons = await getCollection('comparisons');
const sortedComparisons = allComparisons.sort((a, b) => a.data.title.localeCompare(b.data.title));

const pageTitle = 'Tool Comparisons — AI Browser Tools Side by Side';
const pageDescription = 'See how AI browser tools, web agents, and automation frameworks compare head-to-head.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/comparisons/"
>
  <main class="container mx-auto px-6 max-w-5xl pt-24 pb-24">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">Comparisons</h1>
      <p class="text-lg text-muted max-w-2xl">Head-to-head comparisons of AI browser tools. See how they stack up on performance, features, and value.</p>
    </header>

    <div class="space-y-6">
      {sortedComparisons.length > 0 ? sortedComparisons.map((comparison) => {
        const slug = comparison.id.split('/').pop();
        const winnerColor = comparison.data.winner === comparison.data.products[0] ? 'text-primary-400' : 'text-accent-400';
        return (
          <a href={`/en/comparisons/${slug}/`} class="block glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
            <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-4">
              <h2 class="text-xl font-bold text-white group-hover:text-primary-400 transition-colors">
                {comparison.data.title}
              </h2>
              <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
                Winner: {comparison.data.winner}
              </span>
            </div>
            <p class="text-sm text-muted mb-4">{comparison.data.description}</p>
            <div class="flex items-center gap-4 text-sm">
              <div class="flex items-center gap-2">
                <span class="text-muted">{comparison.data.products[0]}</span>
                <span class="font-bold text-white">{comparison.data.scoreA}</span>
                <span class="text-muted text-xs">vs</span>
                <span class="text-muted">{comparison.data.products[1]}</span>
                <span class="font-bold text-white">{comparison.data.scoreB}</span>
              </div>
              <span class="text-xs text-muted">Best for: {comparison.data.bestFor}</span>
            </div>
          </a>
        );
      }) : (
        <div class="text-center py-20">
          <div class="text-4xl mb-4">⚔️</div>
          <h3 class="text-xl font-semibold text-white mb-2">No Comparisons Yet</h3>
          <p class="text-muted">Side-by-side comparisons are coming soon.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>