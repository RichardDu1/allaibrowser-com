---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map(c => ({
    params: { slug: c.id.split('/').pop() },
    props: { comparison: c },
  }));
}

const { comparison } = Astro.props;
const { Content } = await render(comparison);

const slug = comparison.id.split('/').pop();

const pageTitle = `${comparison.data.title} — AI Browser Tools Comparison`;
const pageDescription = comparison.data.description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://allaibrowser.com/en/comparisons/${slug}/`}
>
  <article class="container mx-auto px-6 max-w-5xl pt-24 pb-24">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center text-sm text-muted gap-2">
      <a href="/en/comparisons/" class="hover:text-primary-400 transition-colors">Comparisons</a>
      <span>/</span>
      <span class="text-white">{comparison.data.title}</span>
    </nav>

    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-6 tracking-tight">{comparison.data.title}</h1>
      <p class="text-lg text-muted max-w-3xl">{comparison.data.description}</p>
    </header>

    <!-- Score Comparison Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="glass-card rounded-xl p-6 border-primary-500/20">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-bold text-white">{comparison.data.products[0]}</h3>
          <span class="text-3xl font-bold text-primary-400">{comparison.data.scoreA}</span>
        </div>
        <h4 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">Pros</h4>
        <ul class="space-y-2 mb-4">
          {comparison.data.prosA.map(pro => (
            <li class="text-sm text-white flex items-start gap-2">
              <span class="text-emerald-400 mt-0.5">✓</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
        <h4 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">Cons</h4>
        <ul class="space-y-2">
          {comparison.data.consA.map(con => (
            <li class="text-sm text-white flex items-start gap-2">
              <span class="text-red-400 mt-0.5">✕</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="glass-card rounded-xl p-6 border-accent-500/20">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-bold text-white">{comparison.data.products[1]}</h3>
          <span class="text-3xl font-bold text-accent-400">{comparison.data.scoreB}</span>
        </div>
        <h4 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">Pros</h4>
        <ul class="space-y-2 mb-4">
          {comparison.data.prosB.map(pro => (
            <li class="text-sm text-white flex items-start gap-2">
              <span class="text-emerald-400 mt-0.5">✓</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
        <h4 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">Cons</h4>
        <ul class="space-y-2">
          {comparison.data.consB.map(con => (
            <li class="text-sm text-white flex items-start gap-2">
              <span class="text-red-400 mt-0.5">✕</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Winner Badge -->
    <div class="glass-card rounded-xl p-6 mb-12 border-emerald-500/20 bg-emerald-500/5">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-emerald-400 font-bold text-lg">🏆</span>
        <h3 class="text-lg font-bold text-white">Winner: {comparison.data.winner}</h3>
      </div>
      <p class="text-sm text-muted">{comparison.data.bestFor}</p>
    </div>

    <!-- Full Content -->
    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:font-bold prose-headings:text-white
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-6 prose-h2:border-b prose-h2:border-border prose-h2:pb-4
      prose-h3:text-xl prose-h3:mt-8
      prose-p:text-muted prose-p:leading-relaxed
      prose-a:text-primary-400 hover:prose-a:underline
      prose-code:text-accent-400 prose-code:bg-dark-3 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:border-border
      prose-pre:bg-dark-2 prose-pre:border prose-pre:border-border
      prose-strong:text-white
      prose-th:text-white prose-th:border-border
      prose-td:text-muted prose-td:border-border">
      <Content />
    </div>
  </article>
</BaseLayout>