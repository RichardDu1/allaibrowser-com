---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Contact — AI Browser Reviews';
const pageDescription = 'Get in touch with the AI Browser Reviews team.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/contact/"
>
  <main class="container mx-auto px-6 max-w-3xl pt-24 pb-24">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">Contact</h1>
      <p class="text-lg text-muted">Have a suggestion? Found a tool we should review? Want to collaborate? We'd love to hear from you.</p>
    </header>

    <div class="glass-card rounded-xl p-8">
      <p class="text-muted mb-6">Reach out to us at <a href="mailto:hello@allaibrowser.com" class="text-primary-400 hover:text-primary-300 transition-colors">hello@allaibrowser.com</a></p>
      <p class="text-sm text-muted">We typically respond within 24 hours. For review suggestions, please include the tool name and a brief description.</p>
    </div>
  </main>
</BaseLayout>