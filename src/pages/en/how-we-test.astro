---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'How We Test — AI Browser Review Methodology';
const pageDescription = 'Learn about our rigorous, standardized testing methodology for AI browser tools and web agents.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/how-we-test/"
>
  <main class="container mx-auto px-6 max-w-4xl pt-24 pb-24">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">How We Test</h1>
      <p class="text-lg text-muted max-w-3xl">Every tool on this site goes through the same rigorous, standardized testing process. Here's exactly how we do it.</p>
    </header>

    <div class="space-y-8">
      <section class="glass-card rounded-xl p-8">
        <h2 class="text-xl font-bold text-white mb-4">Scoring Criteria</h2>
        <p class="text-muted text-sm mb-6">Each tool is scored on a 0-10 scale across the following dimensions:</p>
        <div class="space-y-4">
          <div class="flex items-center justify-between p-3 bg-dark-2 rounded-lg border border-border">
            <div>
              <span class="text-white font-medium text-sm">Success Rate</span>
              <p class="text-xs text-muted">Percentage of tasks completed without errors on first attempt</p>
            </div>
            <span class="text-primary-400 font-bold text-sm">30%</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-dark-2 rounded-lg border border-border">
            <div>
              <span class="text-white font-medium text-sm">Speed &amp; Efficiency</span>
              <p class="text-xs text-muted">Task completion time, DOM parsing speed, and resource usage</p>
            </div>
            <span class="text-accent-400 font-bold text-sm">25%</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-dark-2 rounded-lg border border-border">
            <div>
              <span class="text-white font-medium text-sm">Developer Experience</span>
              <p class="text-xs text-muted">API design, documentation quality, error messages, and ease of setup</p>
            </div>
            <span class="text-purple-400 font-bold text-sm">20%</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-dark-2 rounded-lg border border-border">
            <div>
              <span class="text-white font-medium text-sm">Anti-Detection</span>
              <p class="text-xs text-muted">Stealth capabilities, proxy support, and fingerprint randomization</p>
            </div>
            <span class="text-amber-400 font-bold text-sm">15%</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-dark-2 rounded-lg border border-border">
            <div>
              <span class="text-white font-medium text-sm">Ecosystem</span>
              <p class="text-xs text-muted">Community size, plugin availability, integrations, and support</p>
            </div>
            <span class="text-emerald-400 font-bold text-sm">10%</span>
          </div>
        </div>
      </section>

      <section class="glass-card rounded-xl p-8">
        <h2 class="text-xl font-bold text-white mb-4">Test Scenarios</h2>
        <div class="space-y-3">
          <div class="p-3 bg-dark-2 rounded-lg border border-border">
            <h3 class="text-sm font-semibold text-white mb-1">Form Filling &amp; Submission</h3>
            <p class="text-xs text-muted">Navigate to a multi-field form, fill in various input types, and submit. Measures accuracy of field identification and input handling.</p>
          </div>
          <div class="p-3 bg-dark-2 rounded-lg border border-border">
            <h3 class="text-sm font-semibold text-white mb-1">Multi-Step Navigation</h3>
            <p class="text-xs text-muted">Complete a 5+ step workflow involving page navigation, clicks, waits, and data extraction across multiple pages.</p>
          </div>
          <div class="p-3 bg-dark-2 rounded-lg border border-border">
            <h3 class="text-sm font-semibold text-white mb-1">Dynamic Content Handling</h3>
            <p class="text-xs text-muted">Interact with single-page applications (SPAs) that load content dynamically via JavaScript. Measures ability to wait for and interact with dynamic elements.</p>
          </div>
          <div class="p-3 bg-dark-2 rounded-lg border border-border">
            <h3 class="text-sm font-semibold text-white mb-1">Data Extraction</h3>
            <p class="text-xs text-muted">Extract structured data (tables, lists, product details) from pages with varying layouts. Measures extraction accuracy and completeness.</p>
          </div>
          <div class="p-3 bg-dark-2 rounded-lg border border-border">
            <h3 class="text-sm font-semibold text-white mb-1">Anti-Bot Evasion</h3>
            <p class="text-xs text-muted">Test against sites with bot detection (Cloudflare, DataDome, reCAPTCHA). Measures success rate and detection avoidance.</p>
          </div>
        </div>
      </section>

      <section class="glass-card rounded-xl p-8">
        <h2 class="text-xl font-bold text-white mb-4">Verdict System</h2>
        <div class="space-y-3">
          <div class="flex items-center gap-3 p-3 bg-dark-2 rounded-lg border border-emerald-500/20">
            <span class="verdict-buy text-xs font-semibold px-2.5 py-1 rounded-md">✓ Buy</span>
            <div>
              <span class="text-sm text-white font-medium">Score 7.0+</span>
              <p class="text-xs text-muted">Recommended for production use. Tool performs well across all criteria.</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-3 bg-dark-2 rounded-lg border border-amber-500/20">
            <span class="verdict-wait text-xs font-semibold px-2.5 py-1 rounded-md">○ Wait</span>
            <div>
              <span class="text-sm text-white font-medium">Score 5.0-6.9</span>
              <p class="text-xs text-muted">Promising but has significant limitations. Worth monitoring for future releases.</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-3 bg-dark-2 rounded-lg border border-red-500/20">
            <span class="verdict-skip text-xs font-semibold px-2.5 py-1 rounded-md">✕ Skip</span>
            <div>
              <span class="text-sm text-white font-medium">Score Below 5.0</span>
              <p class="text-xs text-muted">Not recommended. Too many issues for practical use.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>