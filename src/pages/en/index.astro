---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';

const allTools = await getCollection('tools');
const allReviews = await getCollection('reviews');

// Combine reviews and tools for the full product listing
const allProducts = [
  ...allReviews.map(r => ({ ...r, collection: 'reviews' })),
  ...allTools.map(t => ({ ...t, collection: 'tools' })),
];

// Get featured products
const featured = allProducts.filter(p => p.data.featured).sort((a, b) => b.data.score - a.data.score);

// Top 3 highest scored
const topRated = [...allProducts].sort((a, b) => b.data.score - a.data.score).slice(0, 6);

const pageTitle = 'AI Browsers & Web Agents Reviewed — Tested, Compared, Ranked';
const pageDescription = 'The first dedicated review site for AI browser tools. We test, compare, and rank Browser Use, Stagehand, Playwright, Puppeteer, AgentQL, Browserbase and more.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/"
  schema={{ type: 'WebSite', data: { description: pageDescription } }}
>
  <Hero
    title=""
    subtitle="We put AI browser tools through real-world tests. See how Browser Use, Stagehand, Playwright, Puppeteer, AgentQL, and Browserbase stack up in scraping, automation, and AI agent tasks."
    ctaText="Browse All Products →"
    ctaLink="/en/products/"
  />

  <!-- Featured Comparison Table -->
  <section class="container mx-auto px-6 max-w-7xl py-16 animate-fade-in-up" style="animation-delay: 0.3s">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-white tracking-tight flex items-center gap-3">
        <span class="w-1.5 h-6 bg-primary-500 rounded-full"></span>
        Top Tools at a Glance
      </h2>
      <a href="/en/products/" class="text-sm text-primary-400 hover:text-primary-300 font-medium transition-colors">
        View All →
      </a>
    </div>

    <div class="overflow-x-auto rounded-xl border border-border">
      <table class="comparison-table w-full min-w-[600px]">
        <thead>
          <tr class="bg-dark-2">
            <th>Tool</th>
            <th>Score</th>
            <th>Pricing</th>
            <th>Open Source</th>
            <th>Best For</th>
            <th>Verdict</th>
          </tr>
        </thead>
        <tbody>
          {topRated.map((product) => {
            const href = product.collection === 'reviews' 
              ? `/en/reviews/${product.id.split('/').pop()}/` 
              : `/en/tools/${product.id.split('/').pop()}/`;
            const scoreColor = product.data.score >= 9 ? 'text-emerald-400' : product.data.score >= 7 ? 'text-primary-400' : product.data.score >= 5 ? 'text-yellow-400' : 'text-red-400';
            const verdictBadge = product.data.verdictLabel === 'buy' ? 'verdict-buy' : product.data.verdictLabel === 'wait' ? 'verdict-wait' : 'verdict-skip';
            return (
              <tr class="group hover:bg-white/[0.02] transition-colors cursor-pointer" onclick={`window.location='${href}'`}>
                <td class="font-medium text-white">
                  <a href={href} class="hover:text-primary-400 transition-colors">
                    {product.data.title}
                  </a>
                </td>
                <td>
                  <span class={`font-bold text-lg ${scoreColor}`}>{product.data.score}</span>
                  <span class="text-muted text-xs">/10</span>
                </td>
                <td class="capitalize">{product.data.pricing}</td>
                <td>
                  {product.data.openSource ? (
                    <span class="text-emerald-400 text-xs font-medium">✓ Yes</span>
                  ) : (
                    <span class="text-muted text-xs">—</span>
                  )}
                </td>
                <td class="text-sm text-muted">
                  {product.data.useCases?.slice(0, 2).join(', ')}
                </td>
                <td>
                  <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${verdictBadge}`}>
                    {product.data.verdictLabel === 'buy' ? '✓ Buy' : product.data.verdictLabel === 'wait' ? '○ Wait' : '✕ Skip'}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Category Navigation -->
  <section class="container mx-auto px-6 max-w-7xl py-16 animate-fade-in-up" style="animation-delay: 0.4s">
    <h2 class="text-xl md:text-2xl font-bold mb-8 text-white tracking-tight flex items-center gap-3">
      <span class="w-1.5 h-6 bg-accent-500 rounded-full"></span>
      Browse by Category
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <a href="/en/best-ofs/web-agents/" class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-lg bg-primary-500/10 border border-primary-500/20 flex items-center justify-center mb-4 group-hover:bg-primary-500/20 transition-colors">
          <svg class="w-5 h-5 text-primary-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 1 7.07 17.07A10 10 0 0 1 4.93 4.93 10 10 0 0 1 12 2z"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="font-semibold text-white mb-1 group-hover:text-primary-400 transition-colors">Web Agents</h3>
        <p class="text-sm text-muted">Browser Use, Stagehand, and other AI-powered web agents</p>
      </a>
      <a href="/en/best-ofs/browser-automation/" class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-lg bg-accent-500/10 border border-accent-500/20 flex items-center justify-center mb-4 group-hover:bg-accent-500/20 transition-colors">
          <svg class="w-5 h-5 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        </div>
        <h3 class="font-semibold text-white mb-1 group-hover:text-accent-400 transition-colors">Browser Automation</h3>
        <p class="text-sm text-muted">Playwright, Puppeteer, Selenium — test and automate</p>
      </a>
      <a href="/en/best-ofs/ai-scraping/" class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mb-4 group-hover:bg-purple-500/20 transition-colors">
          <svg class="w-5 h-5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 0 1 9-9"/></svg>
        </div>
        <h3 class="font-semibold text-white mb-1 group-hover:text-purple-400 transition-colors">AI Scraping</h3>
        <p class="text-sm text-muted">AgentQL, Browserbase, and intelligent data extraction</p>
      </a>
      <a href="/en/best-ofs/testing-tools/" class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-4 group-hover:bg-emerald-500/20 transition-colors">
          <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
        </div>
        <h3 class="font-semibold text-white mb-1 group-hover:text-emerald-400 transition-colors">Testing Tools</h3>
        <p class="text-sm text-muted">Cypress, Playwright Test, and end-to-end frameworks</p>
      </a>
      <a href="/en/best-ofs/browser-extensions/" class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-4 group-hover:bg-amber-500/20 transition-colors">
          <svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"/></svg>
        </div>
        <h3 class="font-semibold text-white mb-1 group-hover:text-amber-400 transition-colors">Browser Extensions</h3>
        <p class="text-sm text-muted">AI-powered browser plugins and tools</p>
      </a>
      <a href="/en/products/" class="glass-card rounded-xl p-6 hover:border-primary-500/30 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-lg bg-white/5 border border-border flex items-center justify-center mb-4 group-hover:bg-white/10 transition-colors">
          <svg class="w-5 h-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        </div>
        <h3 class="font-semibold text-white mb-1 group-hover:text-white transition-colors">View All Products</h3>
        <p class="text-sm text-muted">Browse the complete directory of AI browser tools</p>
      </a>
    </div>
  </section>

  <!-- Featured Products Grid -->
  {featured.length > 0 && (
    <section class="container mx-auto px-6 max-w-7xl py-16 animate-fade-in-up" style="animation-delay: 0.5s">
      <h2 class="text-xl md:text-2xl font-bold mb-8 text-white tracking-tight flex items-center gap-3">
        <span class="w-1.5 h-6 bg-primary-500 rounded-full"></span>
        Featured Reviews
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((product) => {
          const href = product.collection === 'reviews' 
            ? `/en/reviews/${product.id.split('/').pop()}/` 
            : `/en/tools/${product.id.split('/').pop()}/`;
          return (
            <Card
              title={product.data.title}
              description={product.data.description}
              href={href}
              score={product.data.score}
              verdictLabel={product.data.verdictLabel}
              pricing={product.data.pricing}
              useCases={product.data.useCases}
              githubStars={product.data.githubStars}
              featured={product.data.featured}
            />
          );
        })}
      </div>
    </section>
  )}

  <!-- How We Test Section -->
  <section class="container mx-auto px-6 max-w-7xl py-16 animate-fade-in-up" style="animation-delay: 0.6s">
    <div class="glass-card rounded-2xl p-8 md:p-12 border-primary-500/10">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 tracking-tight">How We Test</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-primary-500/10 border border-primary-500/20 flex items-center justify-center shrink-0">
            <span class="text-primary-400 font-bold text-sm">1</span>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-1">Real-World Scenarios</h3>
            <p class="text-sm text-muted leading-relaxed">We test each tool on actual web automation tasks — form filling, multi-step navigation, data extraction, and dynamic content handling.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-accent-500/10 border border-accent-500/20 flex items-center justify-center shrink-0">
            <span class="text-accent-400 font-bold text-sm">2</span>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-1">Standardized Metrics</h3>
            <p class="text-sm text-muted leading-relaxed">Every tool is scored on the same criteria: success rate, speed, token efficiency, anti-detection, developer experience, and documentation quality.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center shrink-0">
            <span class="text-purple-400 font-bold text-sm">3</span>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-1">No Affiliation</h3>
            <p class="text-sm text-muted leading-relaxed">We are independent reviewers. We don't accept payment for rankings, and we disclose any affiliate relationships clearly. Our scores reflect our genuine assessment.</p>
          </div>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-border">
        <a href="/en/how-we-test/" class="text-sm text-primary-400 hover:text-primary-300 font-medium transition-colors">
          Read our full methodology →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>