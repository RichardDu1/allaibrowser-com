---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Privacy Policy — AI Browser Reviews';
const pageDescription = 'Privacy policy for AI Browser Reviews.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/privacy/"
>
  <main class="container mx-auto px-6 max-w-4xl pt-24 pb-24 prose prose-invert prose-lg max-w-none
    prose-headings:font-bold prose-headings:text-white
    prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-6
    prose-p:text-muted prose-p:leading-relaxed
    prose-a:text-primary-400 hover:prose-a:underline
    prose-strong:text-white
    prose-li:text-muted">
    <h1>Privacy Policy</h1>
    <p>Last updated: June 2026</p>

    <h2>Information We Collect</h2>
    <p>We collect minimal information to provide and improve our service:</p>
    <ul>
      <li>Standard web analytics data (page views, referrer, browser type)</li>
      <li>Information you provide via contact forms</li>
    </ul>

    <h2>Cookies</h2>
    <p>We use essential cookies for site functionality and analytics cookies to understand how visitors use our site. You can control cookie preferences through your browser settings.</p>

    <h2>Third-Party Services</h2>
    <p>We may use affiliate links to products we review. If you click an affiliate link and make a purchase, we may earn a commission at no extra cost to you. This does not affect our review scores or recommendations.</p>

    <h2>Contact</h2>
    <p>For privacy-related inquiries, contact us at <a href="mailto:hello@allaibrowser.com">hello@allaibrowser.com</a>.</p>
  </main>
</BaseLayout>