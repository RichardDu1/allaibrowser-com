---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const allTools = await getCollection('tools');
const allReviews = await getCollection('reviews');

const allProducts = [
  ...allReviews.map(r => ({ ...r, collection: 'reviews', slug: r.id.split('/').pop() })),
  ...allTools.map(t => ({ ...t, collection: 'tools', slug: t.id.split('/').pop() })),
];

// Sort by score descending
const sortedProducts = allProducts.sort((a, b) => b.data.score - a.data.score);

const platforms = [...new Set(allProducts.map(p => p.data.platform))];
const pricings = [...new Set(allProducts.map(p => p.data.pricing))];

const pageTitle = 'All AI Browser Products — Reviewed & Ranked';
const pageDescription = 'Browse our complete directory of AI browser tools, web agents, and automation frameworks. Sort by score, filter by platform, and compare features.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/products/"
>
  <main class="container mx-auto px-6 max-w-7xl pt-24 pb-24">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">All Products</h1>
      <p class="text-lg text-muted max-w-2xl">Every AI browser tool, web agent, and automation framework we've tested — ranked by score.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProducts.length > 0 ? sortedProducts.map((product) => {
        const href = product.collection === 'reviews'
          ? `/en/reviews/${product.slug}/`
          : `/en/tools/${product.slug}/`;
        return (
          <Card
            title={product.data.title}
            description={product.data.description}
            href={href}
            score={product.data.score}
            verdictLabel={product.data.verdictLabel}
            pricing={product.data.pricing}
            useCases={product.data.useCases}
            githubStars={product.data.githubStars}
            featured={product.data.featured}
            category={product.data.platform}
          />
        );
      }) : (
        <div class="col-span-full text-center py-20">
          <div class="text-4xl mb-4">🔍</div>
          <h3 class="text-xl font-semibold text-white mb-2">No Products Yet</h3>
          <p class="text-muted">Product reviews are coming soon. Check back for our latest testing results.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>