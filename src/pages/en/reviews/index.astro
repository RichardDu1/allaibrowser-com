---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';

const allReviews = await getCollection('reviews');
const sortedReviews = allReviews.sort((a, b) => b.data.score - a.data.score);

const pageTitle = 'AI Browser Tool Reviews — Expert Tested & Ranked';
const pageDescription = 'In-depth reviews of AI browser tools, web agents, and automation frameworks. Expert testing, honest scores, and data-driven recommendations.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://allaibrowser.com/en/reviews/"
>
  <main class="container mx-auto px-6 max-w-7xl pt-24 pb-24">
    <header class="mb-12">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">Reviews</h1>
      <p class="text-lg text-muted max-w-2xl">In-depth reviews of AI browser tools. Each tool is tested, scored, and ranked based on real-world performance.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedReviews.length > 0 ? sortedReviews.map((review) => {
        const slug = review.id.split('/').pop();
        return (
          <Card
            title={review.data.title}
            description={review.data.description}
            href={`/en/reviews/${slug}/`}
            score={review.data.score}
            verdictLabel={review.data.verdictLabel}
            pricing={review.data.pricing}
            useCases={review.data.useCases}
            githubStars={review.data.githubStars}
            featured={review.data.featured}
            category={review.data.platform}
          />
        );
      }) : (
        <div class="col-span-full text-center py-20">
          <div class="text-4xl mb-4">📝</div>
          <h3 class="text-xl font-semibold text-white mb-2">No Reviews Yet</h3>
          <p class="text-muted">We're working on reviews. Check back soon.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>