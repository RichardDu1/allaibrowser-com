---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(tool => ({
    params: { slug: tool.id.split('/').pop() },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);

const slug = tool.id.split('/').pop();
const scoreColor = tool.data.score >= 9 ? 'text-emerald-400' : tool.data.score >= 7 ? 'text-primary-400' : tool.data.score >= 5 ? 'text-yellow-400' : 'text-red-400';
const verdictBadgeClass = tool.data.verdictLabel === 'buy' ? 'verdict-buy' : tool.data.verdictLabel === 'wait' ? 'verdict-wait' : 'verdict-skip';
const priceClass = `price-${tool.data.pricing}`;

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.data.title,
  "applicationCategory": "DeveloperApplication",
  "description": tool.data.description,
  "offers": { "@type": "Offer", "price": tool.data.pricing === 'free' ? '0' : 'Varies' },
};
---

<BaseLayout
  title={`${tool.data.title} Review — AI Browser Tool`}
  description={tool.data.description}
  canonical={`https://allaibrowser.com/en/tools/${slug}/`}
  schema={{ type: 'SoftwareApplication', data: toolSchema }}
>
  <article class="container mx-auto px-6 max-w-5xl pt-24 pb-24">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center text-sm text-muted gap-2">
      <a href="/en/products/" class="hover:text-primary-400 transition-colors">Products</a>
      <span>/</span>
      <span class="text-white">{tool.data.title}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-12 border-b border-border pb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-medium text-primary-400 bg-primary-500/10 px-2 py-0.5 rounded-full border border-primary-500/20 uppercase">
          {tool.data.platform}
        </span>
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${verdictBadgeClass}`}>
          {tool.data.verdictLabel === 'buy' ? '✓ Buy' : tool.data.verdictLabel === 'wait' ? '○ Wait' : '✕ Skip'}
        </span>
        <span class={`text-xs font-medium ${priceClass} capitalize`}>{tool.data.pricing}</span>
        {tool.data.openSource && (
          <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
            Open Source
          </span>
        )}
      </div>

      <div class="flex items-start justify-between gap-6">
        <div class="flex-1">
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">{tool.data.title}</h1>
          <p class="text-lg text-muted max-w-3xl leading-relaxed">{tool.data.description}</p>
        </div>
        <div class="flex flex-col items-center shrink-0">
          <span class={`text-4xl font-bold ${scoreColor}`}>{tool.data.score}</span>
          <span class="text-xs text-muted uppercase tracking-wider">/10</span>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
        <div class="bg-dark-2 p-4 rounded-xl border border-border">
          <span class="text-[10px] uppercase tracking-widest text-muted block mb-1">Pricing</span>
          <span class={`font-bold capitalize ${priceClass}`}>{tool.data.pricing}</span>
        </div>
        <div class="bg-dark-2 p-4 rounded-xl border border-border">
          <span class="text-[10px] uppercase tracking-widest text-muted block mb-1">Open Source</span>
          <span class={`font-bold ${tool.data.openSource ? 'text-emerald-400' : 'text-muted'}`}>{tool.data.openSource ? 'Yes' : 'No'}</span>
        </div>
        {tool.data.githubStars && (
          <div class="bg-dark-2 p-4 rounded-xl border border-border">
            <span class="text-[10px] uppercase tracking-widest text-muted block mb-1">GitHub Stars</span>
            <span class="font-bold text-white">{(tool.data.githubStars / 1000).toFixed(1)}k</span>
          </div>
        )}
        <div class="bg-dark-2 p-4 rounded-xl border border-border">
          <span class="text-[10px] uppercase tracking-widest text-muted block mb-1">Use Cases</span>
          <span class="font-bold text-white text-sm">{tool.data.useCases?.length || 0}</span>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:font-bold prose-headings:text-white
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-6 prose-h2:border-b prose-h2:border-border prose-h2:pb-4
          prose-h3:text-xl prose-h3:mt-8
          prose-p:text-muted prose-p:leading-relaxed
          prose-a:text-primary-400 hover:prose-a:underline
          prose-code:text-accent-400 prose-code:bg-dark-3 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:border prose-code:border-border
          prose-pre:bg-dark-2 prose-pre:border prose-pre:border-border
          prose-strong:text-white
          prose-li:text-muted">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1 space-y-6">
        <!-- Use Cases -->
        {tool.data.useCases && tool.data.useCases.length > 0 && (
          <div class="glass-card rounded-xl p-6">
            <h3 class="text-sm font-bold text-primary-400 uppercase tracking-wider mb-4">Use Cases</h3>
            <div class="flex flex-wrap gap-2">
              {tool.data.useCases.map(uc => (
                <span class="text-xs text-white bg-white/5 px-2.5 py-1.5 rounded-md border border-border">{uc}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Pros -->
        {tool.data.pros && tool.data.pros.length > 0 && (
          <div class="glass-card rounded-xl p-6 border-emerald-500/10">
            <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-4">✓ Pros</h3>
            <ul class="space-y-2.5">
              {tool.data.pros.map(pro => (
                <li class="text-sm text-white flex items-start gap-2">
                  <span class="text-emerald-400 mt-0.5 shrink-0">✓</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Cons -->
        {tool.data.cons && tool.data.cons.length > 0 && (
          <div class="glass-card rounded-xl p-6 border-red-500/10">
            <h3 class="text-sm font-bold text-red-400 uppercase tracking-wider mb-4">✕ Cons</h3>
            <ul class="space-y-2.5">
              {tool.data.cons.map(con => (
                <li class="text-sm text-white flex items-start gap-2">
                  <span class="text-red-400 mt-0.5 shrink-0">✕</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- GitHub Link -->
        {tool.data.githubUrl && (
          <a href={tool.data.githubUrl} target="_blank" rel="noopener nofollow" class="block w-full text-center bg-white/5 hover:bg-white/10 text-white font-medium px-6 py-3 rounded-xl transition-all duration-200 border border-border hover:border-primary-500/30 text-sm">
            <span class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              View on GitHub
              {tool.data.githubStars && (
                <span class="text-muted text-xs">★ {(tool.data.githubStars / 1000).toFixed(1)}k</span>
              )}
            </span>
          </a>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>