---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = 'AI Browsers & Web Agents Reviewed — Tested, Compared, Ranked';
const pageDescription = 'The first dedicated review site for AI browser tools. We test, compare, and rank Browser Use, Stagehand, Playwright, Puppeteer, AgentQL, Browserbase and more.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <link rel="canonical" href="https://allaibrowser.com/" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="/en/">Redirecting to the English version…</a>
  </body>
</html>